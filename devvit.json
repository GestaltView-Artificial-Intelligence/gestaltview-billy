{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "dev": {
    "subreddit": "gestaltview_billy_dev"
  },
  "menu": {
    "items": [
      {
        "description": "gestaltview-billy",
        "endpoint": "/internal/menu/post-create",
        "forUserType": "moderator",
        "label": "Create a new post",
        "location": "subreddit"
      },
      {
        "description": "Billy reads the post and its top comments, then shows the moderator a private 30-second brief. Nothing is posted.",
        "endpoint": "/internal/menu/summarize-thread",
        "forUserType": "moderator",
        "label": "Ask Billy: summarize thread",
        "location": "post"
      }
    ]
  },
  "name": "gestaltview-billy",
  "permissions": {
    "http": {
      "domains": [
        "https://gestaltview-three.vercel.app",
        "https://keith-soyka-portfolio.vercel.app"
      ],
      "enable": true
    },
    "reddit": {
      "enable": true
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "chat": {
        "entry": "chat.html"
      },
      "default": {
        "entry": "splash.html",
        "inline": true
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "settings": {
    "global": {
      "runtimeSigningSecret": {
        "isSecret": true,
        "label": "GestaltView adapter signing secret",
        "type": "string"
      }
    },
    "subreddit": {
      "dailyRequestLimit": {
        "defaultValue": 20,
        "label": "Daily requests per Reddit user",
        "type": "number"
      },
      "emergencyDisabled": {
        "defaultValue": false,
        "label": "Emergency disable requests",
        "type": "boolean"
      },
      "runtimeApiUrl": {
        "defaultValue": "https://gestaltview-three.vercel.app/api",
        "label": "GestaltView runtime base URL",
        "type": "string"
      },
      "summonEnabled": {
        "defaultValue": true,
        "label": "Respond when summoned in comments (!billy)",
        "type": "boolean"
      }
    }
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onCommentCreate": "/internal/triggers/on-comment-summon"
  }
}
